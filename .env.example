# Application
APP_ENV=development
APP_PORT=8000
# Public application origin used to build links in emails: {BASE_URL}/verify?token=...
# and {BASE_URL}/classes/... (no trailing slash). Must start with http:// or https://.
# Required when APP_ENV=production: the app refuses to start without it.
# Development falls back to http://localhost:8000.
BASE_URL=http://localhost:8000

# Database (Neon PostgreSQL)
# Both DSNs below must use the +psycopg driver tag (project uses psycopg v3,
# not psycopg2): postgresql+psycopg://user:pass@host/db?sslmode=require
# pooled Neon connection, used by the app (session.py)
DATABASE_URL=
# direct Neon connection, used by Alembic only (env.py)
DATABASE_URL_UNPOOLED=
# Optional. Only tests marked `postgres` read this, and they insert and delete
# rows, so it must point at a throwaway Neon branch — never at the same compute
# as DATABASE_URL. tests/conftest.py fails the run if it does. Leave it empty
# and those tests skip themselves; CI fills it in per run.
POSTGRES_TEST_URL=

# Object storage (Cloudflare R2)
# Cloudflare account id, part of the R2 endpoint
R2_ACCOUNT_ID=
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# public base URL for serving uploaded objects
R2_PUBLIC_URL=

# AI (OpenRouter)
# Get your key at https://openrouter.ai → Settings → Keys
# Leave empty to run in stub/demo mode (no real LLM calls).
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models
# Default when unset: poolside/laguna-s-2.1:free (DEFAULT_GENERATION_MODEL in config.py)
GENERATION_MODEL=poolside/laguna-s-2.1:free
# Models an Admin may choose on A-01 (comma-separated). These three come from
# the OPS-26 free-tier comparison (ADR-0012); re-run
# scripts/compare_generation_models.py before editing, OpenRouter's free tier
# changes weekly.
# Default when unset: DEFAULT_GENERATION_ALLOWLIST in config.py
GENERATION_MODEL_ALLOWLIST=poolside/laguna-s-2.1:free,poolside/laguna-xs-2.1:free,nvidia/nemotron-3-super-120b-a12b:free
# Embedding model for RAG chunks. It must return 768 dimensions, and changing
# it means re-embedding every chunk. Default when unset: google/gemini-embedding-001
EMBEDDING_MODEL=google/gemini-embedding-001

# Code runner (Judge0 CE). Leave JUDGE0_URL empty to use the stub, which runs nothing.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=

# Email (OPS-37). EMAIL_BACKEND is stub, smtp or resend.
# stub only logs emails. APP_ENV=production refuses it (and an unset value):
# production must use smtp or resend.
EMAIL_BACKEND=stub
# Sender for smtp and resend: addr@domain or Name <addr@domain>.
EMAIL_FROM=
# smtp: all four of EMAIL_FROM, SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD are required.
# Free Render/Railway block outbound SMTP: use resend there.
SMTP_HOST=
# Optional: 587 for starttls, 465 for ssl when empty.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default) or ssl
SMTP_SECURITY=starttls
# resend: EMAIL_FROM and RESEND_API_KEY are required, and EMAIL_FROM must be on a
# domain verified in Resend to mail @kmitl.ac.th.
RESEND_API_KEY=
